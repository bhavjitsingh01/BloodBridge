# Node Environment
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/bloodbridge?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters
JWT_REFRESH_EXPIRE=7d

# Frontend
FRONTEND_URL=http://localhost:3000
FRONTEND_PRODUCTION_URL=https://yourdomain.com

# CORS
CORS_ENABLED=true

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Email (for notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# SMS (for critical notifications - optional)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your-twilio-account-sid
SMS_AUTH_TOKEN=your-twilio-auth-token
SMS_FROM_NUMBER=+1234567890

# AI Service (for predictions)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=your-ai-service-key

# Google Maps (for geolocation)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Redis (for caching - optional)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Admin
ADMIN_EMAIL=admin@bloodbridge.com
ADMIN_PASSWORD=secure-password-change-in-production
