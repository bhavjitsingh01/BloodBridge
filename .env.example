# === FRONTEND ENVIRONMENT VARIABLES ===

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment (development, production, staging)
NODE_ENV=production


# === BACKEND ENVIRONMENT VARIABLES ===

# Server Configuration
PORT=5001
NODE_ENV=production

# MongoDB Configuration
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/bloodbridge?authSource=admin
MONGODB_USER=admin
MONGODB_PASSWORD=admin123
MONGODB_DATABASE=bloodbridge

# JWT Configuration (Change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# API Configuration
API_SERVER_URL=http://localhost:5001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=info
LOG_FILE=logs/bloodbridge.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Email Configuration (Optional - for future notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false

# Feature Flags
ENABLE_SOCKET_IO=true
ENABLE_AI_PREDICTIONS=true
ENABLE_EMERGENCY_NOTIFICATIONS=true

# Performance
ENABLE_CACHING=true
CACHE_TTL=3600

# Security
ENABLE_HELMET=true
ENABLE_RATE_LIMITING=true
TRUST_PROXY=1
